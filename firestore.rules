rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Initial admin-only stage: create only the administrator account in Firebase Authentication.
    // Do not create delivery partner accounts until rider-specific rules are added.
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }
    match /riders/{riderId} {
      allow read, write: if request.auth != null;
    }
  }
}